{
  "name": "@school/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./seed/*": {
      "types": "./dist/seed/*.d.ts",
      "default": "./dist/seed/*.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "prisma migrate deploy",
    "seed": "node dist/seed/main.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@school/shared": "workspace:*",
    "argon2": "0.45.2",
    "luxon": "3.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
