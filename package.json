{
  "name": "school",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:libs": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build:libs && pnpm -r --parallel run typecheck",
    "lint": "pnpm run build:libs && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm run build:libs && vitest run",
    "test:unit": "pnpm run build:libs && vitest run --project unit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.7",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "3.2.7"
  }
}
