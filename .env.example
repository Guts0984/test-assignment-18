# Copy to .env and run:  cp .env.example .env && docker compose up --build
# Every secret below is a DEVELOPMENT-ONLY placeholder that works as is. Replace all of them
# before exposing the system to anyone.

# --- General ---------------------------------------------------------------------------------
# Runtime mode.
NODE_ENV=production
# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Private network of the containers. Change it only if it overlaps a network you use.
COMPOSE_SUBNET=10.213.47.0/24
# Public port of nginx. If you change it, change PUBLIC_BASE_URL, CORS_ORIGINS and
# PAYSTUB_PUBLIC_URL to match.
HTTP_PORT=8080
# Public origin, used for payment callbacks, return URLs and certificate links.
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS and the CSRF Origin check.
CORS_ORIGINS=http://localhost:8080

# --- PostgreSQL ------------------------------------------------------------------------------
# Database user created by the postgres container.
POSTGRES_USER=school
# Database password. DEV ONLY.
POSTGRES_PASSWORD=dev-only-postgres-password
# Main database name.
POSTGRES_DB=school
# Port published on 127.0.0.1 for tools and tests on the host.
POSTGRES_HOST_PORT=5432
# DSN for processes on the host (tests). Containers get an in-network DSN from compose.
DATABASE_URL=postgresql://school:dev-only-postgres-password@127.0.0.1:5432/school

# --- Redis -----------------------------------------------------------------------------------
# Port published on 127.0.0.1.
REDIS_HOST_PORT=6379
# Redis URL for processes on the host. Containers use redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# --- API -------------------------------------------------------------------------------------
# Port each api copy listens on.
API_PORT=3000
# Name of this api copy, returned in the X-Instance header. Compose sets api-1 and api-2.
INSTANCE_ID=api
# Peers whose X-Real-IP header is trusted when the api runs outside compose. Compose ignores
# this and trusts COMPOSE_SUBNET.
TRUSTED_PROXY_CIDRS=10.213.47.0/24
# HMAC key for access tokens, at least 32 characters. DEV ONLY.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me-0123456789
# Access token lifetime, seconds.
JWT_ACCESS_TTL_SEC=900
# Refresh token lifetime, seconds.
REFRESH_TTL_SEC=2592000
# Set the Secure flag on cookies (requires HTTPS).
COOKIE_SECURE=false
# Largest JSON request body, bytes.
BODY_LIMIT_JSON_BYTES=102400
# Largest homework file, bytes.
UPLOAD_MAX_BYTES=10485760
# AES-256-GCM key protecting stored gateway keys: 32 bytes, base64. DEV ONLY.
GATEWAY_ENCRYPTION_KEY=ZGV2LW9ubHktZ2F0ZXdheS1lbmNyeXB0LWtleS0zMmI=
# Largest age of a signed payment notification, seconds.
WEBHOOK_MAX_SKEW_SEC=300

# Where the payment system sends its notifications (reachable from the payment system).
WEBHOOK_CALLBACK_URL=http://nginx/api/payments/webhook

# --- Business timings ------------------------------------------------------------------------
# Seat hold length, seconds (15 minutes).
HOLD_TTL_SEC=900
# Waitlist offer length, seconds (24 hours).
OFFER_TTL_SEC=86400
# Submissions one mentor may have in review at once.
MENTOR_REVIEW_LIMIT=5

# --- Rate limiting (login and registration only) ---------------------------------------------
# Turn the limiter on or off.
RATE_LIMIT_ENABLED=true
# Login attempts per client IP per window.
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SEC=60
# Login attempts per account and client address per window (never locks the owner out).
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SEC=300
# Registrations per client IP per window.
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SEC=3600
# Behaviour while Redis is down: open (allow) or closed (reject).
RATE_LIMIT_FAIL_MODE=open

# --- Test clock ------------------------------------------------------------------------------
# Enables the shared movable clock and its control route. Never enable in production.
TEST_CLOCK_ENABLED=false
# Token for test-control routes. Required when the test clock or stub controls are on.
TEST_CONTROL_TOKEN=

# --- Worker ----------------------------------------------------------------------------------
# Namespace of the job queues in Redis.
QUEUE_PREFIX=school
# Parallel jobs per queue in one worker.
WORKER_CONCURRENCY=8
# A job without a heartbeat for this long is taken over by another worker, milliseconds.
JOB_LOCK_MS=30000
# A worker that dies while sending an email frees it after this long, milliseconds.
EMAIL_LEASE_MS=60000
# How often due work is re-read from Postgres, milliseconds.
SWEEP_INTERVAL_MS=2000
# Attempts per job and base delay of the exponential backoff.
JOB_ATTEMPTS=8
JOB_BACKOFF_MS=2000
# Timeout for calls to the payment system, milliseconds.
PAYSTUB_HTTP_TIMEOUT_MS=5000

# --- Mail ------------------------------------------------------------------------------------
# SMTP server for processes on the host. Containers use mailpit:1025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Mailbox web UI and API port published on 127.0.0.1.
MAILPIT_UI_PORT=8025
# Sender address.
MAIL_FROM=school@example.test
# Mailbox API used by tests.
MAILPIT_API_URL=http://127.0.0.1:8025

# --- Web -------------------------------------------------------------------------------------
# Base URL the web server uses to reach the API from inside the network.
API_INTERNAL_URL=http://nginx
# Browser-visible API base path.
NEXT_PUBLIC_API_BASE_URL=/api
# Browser-visible Socket.IO path.
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# --- Payment system stub ---------------------------------------------------------------------
# Port the stub listens on.
PAYSTUB_PORT=4000
# Stub database DSN (host). Compose supplies the in-network one.
PAYSTUB_DATABASE_URL=postgresql://school:dev-only-postgres-password@127.0.0.1:5432/paystub
# HMAC key shared between the stub and each school's gateway settings. DEV ONLY.
PAYSTUB_MERCHANT_KEY=dev-only-paystub-merchant-key-change-me
# In-network address of the stub, given to each school's gateway settings by the seed.
PAYSTUB_INTERNAL_URL=http://paystub:4000
# Browser-visible base URL of the payment pages.
PAYSTUB_PUBLIC_URL=http://localhost:8080/paystub
# Chaos mode: duplicate, late and early notifications, failing refunds.
PAYSTUB_CHAOS_MODE=false
# API copies that receive simultaneous duplicate notifications in chaos mode.
PAYSTUB_CHAOS_API_TARGETS=http://api-1:3000,http://api-2:3000
# Share of payment notifications delivered late, and the delay in seconds (20 minutes).
PAYSTUB_CHAOS_LATE_PROBABILITY=0.2
PAYSTUB_CHAOS_LATE_DELAY_SEC=1200
# Share of refund notifications sent before the refund response.
PAYSTUB_CHAOS_EARLY_REFUND_PROBABILITY=0.5
# Every Nth refund request fails with 500 or a timeout.
PAYSTUB_CHAOS_REFUND_FAIL_EVERY=5
# Notification redelivery: attempts and base delay, milliseconds.
PAYSTUB_RETRY_MAX=10
PAYSTUB_RETRY_BASE_MS=1000

# --- Seed ------------------------------------------------------------------------------------
# Seed the database on start.
SEED_ON_START=true
# Size multiplier of the seed. 1 is the full data set.
SEED_SCALE=1
# Password of every seeded account. A published demo value, not a secret.
SEED_DEMO_PASSWORD=demo-password-2026
